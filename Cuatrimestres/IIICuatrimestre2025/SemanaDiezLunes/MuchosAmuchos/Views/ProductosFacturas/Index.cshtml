@model IEnumerable<MuchosAmuchos.Models.ProductosFactura>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Factura)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Producto)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Factura.FacturaId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Producto.Nombre)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ProductosFacturaID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.ProductosFacturaID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.ProductosFacturaID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
