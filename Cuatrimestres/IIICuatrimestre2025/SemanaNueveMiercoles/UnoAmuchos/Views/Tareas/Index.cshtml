@model IEnumerable<UnoAmuchos.Models.Tarea>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TituloTarea)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Descripcion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Proyecto)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.TituloTarea)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Descripcion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Proyecto.Titulo)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdTarea">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdTarea">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdTarea">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
